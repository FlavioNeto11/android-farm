# Android Farm Environment Configuration

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/farm.db

# Secret Store
SECRET_STORE_KEY_FILE=./data/secret.key
SECRET_STORE_STORAGE_PATH=./data/secrets/

# Proxy Pool
PROXY_POOL_SIZE=10
PROXY_ROTATION_STRATEGY=round_robin

# Browser
BROWSER_HEADLESS=true
BROWSER_ANTI_DETECT=true

# Logging
LOGGING_LEVEL=INFO
LOGGING_FILE=./logs/farm.log
LOGGING_MAX_SIZE_MB=10
LOGGING_BACKUP_COUNT=5

# Instagram Verification
INSTAGRAM_VERIFY_ACCOUNTS=true
INSTAGRAM_VERIFICATION_RETRIES=3
INSTAGRAM_VERIFICATION_TIMEOUT=10

# Proxy Support (recommended for Instagram)
PROXY_POOL_SIZE=5

# Android API (persona repository)
ANDROID_API_URL=http://127.0.0.1:8000

# Session Persistence
SESSION_PERSISTENCE=true
